# Large dataset dumps and model binaries (keep directory structure via .gitkeep)
data/raw/official/*
!data/raw/official/.gitkeep
data/raw/manual_test/*
!data/raw/manual_test/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
